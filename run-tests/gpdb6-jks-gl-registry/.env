DOCKER_NETWORK=dwh-net

JENKINS_VERSION=2.516.3-lts-plg7.2
JENKINS_CONTAINER_NAME=jenkins
JENKINS_URL=jenkins.local
JENKINS_EXTERNAL_PORT=8080
DOCKER_GID=988
START_ADMIN_USERNAME=admin
START_ADMIN_PASSWORD=password

GITLAB_VERSION=17.2.9-ce.0
GITLAB_HOSTNAME=gitlab.local
GITLAB_PORT=80
GITLAB_URL="http://${GITLAB_HOSTNAME}:${GITLAB_PORT}"
GITLAB_EXTERNAL_PORT=8081
GITLAB_CONTAINER_NAME=gitlab
INITIAL_ROOT_PASSWORD=beliberda
# Таймаут для запуска Gitlab
START_PERIOD=150

REGISTRY_CONTAINER_NAME=registry
REGISTRY_HOSTNAME=registry.local
REGISTRY_PORT=5000
REGISTRY_EXTERNAL_PORT=5000
REGISTRY_URL="${REGISTRY_HOSTNAME}:${REGISTRY_PORT}"

# For GPDB 6 on Oracle Linux 8
IMAGE_NAME="app-registry01.corp.skbbank.ru/dcms-test/greenplum"
TAG=6.27.1-oraclelinux8
CONFIG_FOLDER="6"
EXPOSE_MASTER_PORT=5432
GREENPLUM_HOSTNAME=master
GREENPLUM_DATABASE_NAME=adb
GREENPLUM_USER=gpadmin
GREENPLUM_SECRETS_DIR=/opt/gpdb-secrets

# Test passwords
ADB_DEPLOY_CDJKS_PASSWORD=PaswdQ802
