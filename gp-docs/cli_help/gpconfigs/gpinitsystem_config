# НАЗВАНИЕ ФАЙЛА: gpinitsystem_config

# Конфигурационнй файл, необходимый для gpinitsystem

################################################
#### ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
################################################

#### Название этой системы Greenplum, заключеннное в кавычки.
ARRAY_NAME="Greenplum Data Platform"

#### Правила именования каталогов данных data, создаваемых утилитами.
SEG_PREFIX=gpseg

#### Базовое число, по которому рассчитываются номера портов primary сегмента.
PORT_BASE=6000

#### Расположение файловой системы, где будут созданы каталоги данных primary сегментов.
#### Количество расположений в списке определяет количество primary сегментов,
#### которые будут созданы для каждого физического хоста (если в файле hostfile
#### указано несколько адресов для хоста, количество сегментов будет равномерно
#### распределено по указанным адресам интерфейсов).
declare -a DATA_DIRECTORY=(/data1/primary /data1/primary /data1/primary /data2/primary /data2/primary /data2/primary)

#### Имя хоста или IP-адрес главного хоста, заданные операционной системой.
MASTER_HOSTNAME=mdw

#### Местоположение в файловой системе, где будет создан каталог данных master.
MASTER_DIRECTORY=/data/master

#### Номер порта для экземпляра master.
MASTER_PORT=5432

#### Утилита командной оболочки, используемая для подключения к удаленным хостам.
TRUSTED_SHELL=ssh

#### Максимальное количество сегментов файла журнала между автоматическими контрольными точками WAL.
CHECK_POINT_SEGMENTS=8

#### Кодировка символов по умолчанию на стороне сервера.
ENCODING=UNICODE

################################################
#### ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ ЗЕРКАЛА
################################################

#### Базовое число, по которому рассчитываются номера портов зеркальных сегментов.
#MIRROR_PORT_BASE=7000

#### Расположение файловой системы, где будут созданы каталоги данных зеркальных сегментов.
#### Количество расположений зеркал должно равняться количеству расположений primary,
#### указанных в параметре DATA_DIRECTORY.
#declare -a MIRROR_DATA_DIRECTORY=(/data1/mirror /data1/mirror /data1/mirror /data2/mirror /data2/mirror /data2/mirror)


################################################
#### ДРУГИЕ ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ
################################################

#### После инициализации создайте базу данных с этим именем.
#DATABASE_NAME=name_of_database

#### Укажите здесь расположение файла с адресами хостов,
#### а не с помощью параметра -h команды gpinitsystem.
#MACHINE_LIST_FILE=/home/gpadmin/gpconfigs/hostfile_gpinitsystem
