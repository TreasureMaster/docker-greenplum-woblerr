# НАЗВАНИЕ ФАЙЛА: gpinitsystem_singlenode

# Для работы утилиты gpinitsystem необходим конфигурационный файл.
# Этот пример файла инициализирует систему Greenplum Database Single Node Edition (SNE)
# с одним главным экземпляром и двумя экземплярами сегментов
# на локальном хосте. Этот файл используется при запуске gpinitsystem. 

################################################
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
################################################

# Имя для настраиваемого массива. Вы можете использовать любое имя
# по своему усмотрению. Если имя содержит пробелы, заключите его в кавычки.

ARRAY_NAME="GPDB SINGLENODE"


# Это указывает на файл, содержащий список имен хостов сегментов,
# составляющих систему Greenplum. Для одноузловой системы этот файл
# содержит локальное имя хоста, настроенное операционной системой
# (как это выводится командой hostname).
# Если файл находится не в том же каталоге, где выполняется утилита
# gpinitsystem, укажите абсолютный путь к файлу.

MACHINE_LIST_FILE=./hostlist_singlenode


# Это задаёт префикс, который будет использоваться для именования
# каталогов данных экземпляров главного сервера и сегментов.
# В системе Greenplum Database используется соглашение об именовании
# каталогов данных SEG_PREFIX<number>, где <number> начинается
# с 0 для экземпляров сегментов, а для главного сервера всегда -1.
# Например, если вы выберете префикс gpsne, каталог данных вашего
# экземпляра главного сервера будет называться gpsne-1,
# а экземпляров сегментов — gpsne0, gpsne1, gpsne2, gpsne3 и так далее.

SEG_PREFIX=gpsne


# Базовый номер порта, на котором будут запускаться экземпляры
# primary сегмента на хосте сегмента. Базовый номер порта будет
# увеличиваться на единицу для каждого экземпляра сегмента, запущенного на хосте.

PORT_BASE=6000


# Это указывает место(а) хранения данных, где скрипт будет
# создавать каталоги данных основных primary сегментов. Скрипт
# создает уникальный каталог данных для каждого экземпляра сегмента.
# Если вам нужно несколько экземпляров сегментов на хост,
# укажите область хранения данных для каждого основного primary сегмента,
# который вы хотите создать. Рекомендуемое количество — один основной
# primary сегмент на каждый процессор. Допустимо указывать одну и ту же
# область хранения данных несколько раз, если вы хотите, чтобы ваши
# каталоги данных создавались в одном и том же месте. Количество
# указанных местоположений каталогов данных определит количество
# экземпляров основных primary сегментов, создаваемых на хосте.
# Необходимо убедиться, что пользователь, запускающий gpinitsystem
# (например, пользователь gpadmin), имеет права на запись в эти каталоги.
# Возможно, вам потребуется создать эти каталоги на хостах сегментов
# перед запуском gpinitsystem и изменить их владельца на соответствующего пользователя.

declare -a DATA_DIRECTORY=(/gpdata1 /gpdata2)


# Имя хоста, заданное операционной системой, для главного экземпляра базы данных Greenplum.

MASTER_HOSTNAME=hostname_of_machine


# Местоположение, где будет создан каталог данных на главном хосте Greenplum.
# Необходимо убедиться, что у пользователя, запускающего gpinitsystem,
# есть права на запись в этот каталог. Возможно, вам потребуется создать
# этот каталог на главном хосте до запуска gpinitsystem и изменить
# его владельца на соответствующего пользователя.

MASTER_DIRECTORY=/gpmaster


# Номер порта для главного экземпляра. Это номер порта, который будут
# использовать пользователи и клиентские подключения при доступе
# к системе базы данных Greenplum.

MASTER_PORT=5432


# Оболочка, которую использует скрипт gpinitsystem для выполнения
# команд на удаленных хостах. Допустимое значение — ssh.
# Перед запуском скрипта gpinitsystem необходимо настроить
# доверенную среду хоста. Для этого можно использовать gpssh-exkeys.

TRUSTED_SHELL=ssh


# Максимальное расстояние между контрольными точками автоматического
# журнала предварительной записи (WAL) в сегментах файла журнала
# (каждый сегмент обычно составляет 16 мегабайт).
# Это установит параметр checkpoint_segments в файле postgresql.conf
# для каждого экземпляра сегмента в системе базы данных Greenplum.

CHECK_POINT_SEGMENTS=8


# Кодировка символов для использования. Greenplum поддерживает
# те же кодировки, что и PostgreSQL. Список допустимых кодировок
# см. в разделе «Поддержка кодировок» документации PostgreSQL.
# Должна соответствовать локали операционной системы, указанной
# с помощью параметра gpinitsystem -n.

ENCODING=UNICODE


################################################
# ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ
################################################

# Необязательно. Раскомментируйте, чтобы создать базу данных
# с этим именем после инициализации системы. Вы всегда можете
# создать базу данных позже, используя команду CREATE DATABASE
# или скрипт createdb.

#DATABASE_NAME=warehouse
